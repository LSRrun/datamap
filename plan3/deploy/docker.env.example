# Copy this file to plan3/.env and replace both secrets before starting Compose.
# Generate each value with the command shown in plan3/deploy/README.md.
CATALOG_DB_PASSWORD=replace-with-a-random-hex-password
DATAMAP_CREDENTIAL_MASTER_KEY=replace-with-a-64-character-hex-key

# The application is bound to the server loopback interface by default.
DATAMAP_HOST_PORT=58974
